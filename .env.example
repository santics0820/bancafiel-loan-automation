# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_ACCOUNT_ID=your_account_id_here

# Database Configuration (RDS PostgreSQL)
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=bancafiel_loans
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# S3 Buckets
S3_BUCKET_DOCUMENTS=bancafiel-loan-documents-prod
S3_BUCKET_BACKUPS=bancafiel-backups-prod

# API Gateway
API_GATEWAY_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Cognito
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=your_client_id_here

# SES Email
SES_SENDER_EMAIL=noreply@bancafiel.com

# Environment
NODE_ENV=development
PYTHON_ENV=development

# Frontend URLs
REACT_APP_API_URL=http://localhost:3001
REACT_APP_COGNITO_REGION=us-east-1
REACT_APP_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
REACT_APP_COGNITO_CLIENT_ID=your_client_id_here

# Backend Configuration
LAMBDA_TIMEOUT=30
LAMBDA_MEMORY=512

# Fraud Detection
FRAUD_DETECTOR_ENDPOINT=your-fraud-detector-endpoint
FRAUD_THRESHOLD=0.7

# Step Functions
STEP_FUNCTION_ARN=arn:aws:states:us-east-1:123456789012:stateMachine:loan-workflow

# Bedrock OCR (Claude Sonnet 4.5)
TEXTRACT_ROLE_ARN=arn:aws:iam::123456789012:role/Bedrock OCR (Claude Sonnet 4.5)Role

# Monitoring
CLOUDWATCH_LOG_GROUP=/aws/lambda/bancafiel-loans
